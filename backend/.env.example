# Postgres connection string (same database the frontend writes to via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/incidentsdb"

# Shared AES-256-GCM key for encrypting/decrypting User.phone at rest.
# Must be a 64-char hex string and MUST match frontend/.env's PHONE_ENCRYPTION_KEY
# exactly, or phone numbers written by the frontend can't be decrypted here.
# Generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=""

# Redis cache for AI incident summaries. Falls back to an in-memory dict if unset
# or unreachable.
REDIS_HOST="localhost"
REDIS_PORT=6379

# Overrides the Caltrans KML feed URL. Leave unset in production. For local
# testing with injected incidents, point this at a fixture file, e.g.:
#   CALTRANS_FEED_URL="file:///absolute/path/to/backend/fixtures/injected_incidents.kml"
# See "Local Testing with Injected Incidents" in backend/README.md.
CALTRANS_FEED_URL=""

# If unset, incident summaries fall back to a templated mock string instead of
# calling the Gemini API.
GEMINI_API_KEY=""

# If TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN are unset (or left as "dummy_sid"/
# "dummy_token"), SMS dispatch falls back to console-logging the message instead
# of sending a real text.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+15550000000"
