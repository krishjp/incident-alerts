# Marks the deployment. Anything other than development/dev/test/local turns on
# the extra production checks in config.py (rejects default postgres credentials,
# a localhost DATABASE_URL, and half-configured Twilio credentials).
ENVIRONMENT="development"

# Postgres connection string (same database the frontend writes to via Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/incidentsdb"

# SQLAlchemy connection pool. Keep pool_size + max_overflow, across every worker
# instance, comfortably below the database's max_connections — the Next.js
# frontend's Prisma pool draws from the same budget.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Shared AES-256-GCM key for encrypting/decrypting User.phone at rest.
# Must be a 64-char hex string and MUST match frontend/.env's PHONE_ENCRYPTION_KEY
# exactly, or phone numbers written by the frontend can't be decrypted here.
# Generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=""

# Redis, used for AI summary caching and for making the notification queue
# durable across restarts. Falls back to in-memory (and in-process-only queue
# durability) if unset or unreachable.
#
# REDIS_URL wins when set — this is the form managed providers hand out:
#   REDIS_URL="rediss://default:<password>@<host>:<port>"
# Otherwise host/port are used (the local docker-compose setup publishes Redis
# on host port 6381, mapped to the container's 6379).
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT=6381
REDIS_DB=0

# The worker runs a single poll pass and exits — the shape a Cloud Run Job,
# cron invocation, or scripts/run-worker-loop.{sh,ps1} wants. There is no
# long-lived loop mode.
#
# TTL on the Redis lock that stops two scheduled executions overlapping (a
# scheduler does not wait for the previous run to finish). Set it above the
# worst-case run time, and keep it aligned with the Cloud Run Job's
# --task-timeout. Without Redis there is no overlap protection.
RUN_LOCK_TTL_SECONDS=300

# Buffer, in miles, around a subscription's route polyline within which an
# incident counts as relevant.
MATCH_RADIUS_MILES=3.0
# Word-overlap score (0..1) above which a new alert summary counts as a rewording
# of one already sent and no SMS goes out (see alert_dedupe.py).
SUMMARY_SIMILARITY_THRESHOLD=0.85
# Vercel AI Gateway key for the decision model that judges near-duplicate alerts.
# Unset: dedupe falls back to the word-overlap score above.
AI_GATEWAY_API_KEY=""
# Any AI Gateway decision model: convaiinnovations/laya, convaiinnovations/laya-free, typesafe-ai/jev
DEDUPE_MODEL="convaiinnovations/laya"
# Probability (0..1) of "same alert" at or above which no SMS goes out.
DEDUPE_MIN_PROBABILITY=0.85

# Overrides the Caltrans KML feed URL. Leave unset in production. For local
# testing with injected incidents, point this at a fixture file. A path without a
# scheme is relative to backend/, which also works inside the worker container:
#   CALTRANS_FEED_URL="fixtures/injected_incidents.kml"
# See "Local Testing with Injected Incidents" in backend/README.md.
CALTRANS_FEED_URL=""

# If unset, incident summaries fall back to a templated mock string instead of
# calling the Gemini API.
GEMINI_API_KEY=""

# If TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN are unset (or left as "dummy_sid"/
# "dummy_token"), SMS dispatch falls back to console-logging the message instead
# of sending a real text.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+15550000000"
