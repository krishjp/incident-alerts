generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection: PgBouncer-style poolers
  // in transaction mode can't run the advisory locks and DDL a migration issues.
  // Falls back to DATABASE_URL when unset, which is correct for a direct-connect
  // database (local docker-compose, Cloud SQL without a pooler).
  directUrl = env("DIRECT_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  accounts      Account[]
  sessions      Session[]
  subscriptions RouteSubscription[]
}

model RouteSubscription {
  id          String   @id @default(cuid())
  userId      String
  origin      String
  destination String
  polyline    String   @db.Text
  area        String   // e.g. "Los Angeles"
  startTime   String   // e.g. "07:00"
  endTime     String   // e.g. "08:00"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Persistent cache of generated route polylines, keyed by a normalized
/// origin+destination pair. Subscription creation would otherwise hit
/// Nominatim/OSRM (or the Google Directions API) on every request, which
/// rate-limits aggressively (HTTP 429) and costs money respectively.
/// Two users commuting the same corridor now share one lookup.
model RouteCache {
  /// sha256 of "<normalized origin>|<normalized destination>|<provider>"
  key         String   @id
  origin      String
  destination String
  provider    String   // "google" | "osrm"
  polyline    String   @db.Text
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model NotifiedIncident {
  id        String   @id // Formatted as "subId_incidentNumber"
  state     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
