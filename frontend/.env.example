# Postgres connection string (same database the backend worker reads via SQLAlchemy)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/incidentsdb"

# NextAuth JWT signing secret. Must be >=32 chars and not a known placeholder.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=""

# Base URL NextAuth uses for callbacks. Match your dev/deploy origin.
NEXTAUTH_URL="http://localhost:3000"

# Shared AES-256-GCM key for encrypting/decrypting User.phone at rest.
# Must be a 64-char hex string and MUST match backend/.env's PHONE_ENCRYPTION_KEY
# exactly, or phone numbers written here can't be decrypted by the backend.
# Generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=""

# Google OAuth login (NextAuth). If unset, falls back to "dummy" and Google
# sign-in will not work, but credentials (email/password) login still does.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps Directions API key, restricted to the Directions API, used to
# generate the route polyline at subscription-creation time
# (src/app/api/subscriptions/route.ts). If unset, falls back to free
# Nominatim geocoding + OSRM routing (src/lib/routing.ts).
GOOGLE_MAPS_API_KEY=""
