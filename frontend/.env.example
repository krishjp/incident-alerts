# Postgres connection string (same database the backend worker reads via SQLAlchemy).
#
# On a serverless deploy (Vercel) each instance opens its own pool, so cap it
# explicitly and keep the total across instances + the Python worker below the
# database's max_connections:
#   DATABASE_URL="postgresql://user:pass@host/db?sslmode=require&connection_limit=5&pool_timeout=20"
# Providers that offer a pooled endpoint (Neon's -pooler host, Supabase's pgbouncer
# port) should use it here, with the direct endpoint in DIRECT_URL for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/incidentsdb"

# Direct (non-pooled) connection, used only by `prisma migrate`: transaction-mode
# poolers can't run the advisory locks and DDL migrations need. Set it to the same
# value as DATABASE_URL when connecting to the database directly.
DIRECT_URL="postgresql://postgres:postgres@localhost:5434/incidentsdb"

# NextAuth JWT signing secret. Must be >=32 chars and not a known placeholder.
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=""

# Base URL NextAuth uses for callbacks. Must match the deployed origin exactly
# (https://your-app.vercel.app in production) or OAuth callbacks fail.
NEXTAUTH_URL="http://localhost:3000"

# Shared AES-256-GCM key for encrypting/decrypting User.phone at rest.
# Must be a 64-char hex string and MUST match backend/.env's PHONE_ENCRYPTION_KEY
# exactly, or phone numbers written here can't be decrypted by the backend.
# Generate with: openssl rand -hex 32
PHONE_ENCRYPTION_KEY=""

# Google OAuth login (NextAuth). If unset, falls back to "dummy" and Google
# sign-in will not work, but credentials (email/password) login still does.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Maps Directions API key, restricted to the Directions API, used to
# generate the route polyline at subscription-creation time
# (src/app/api/subscriptions/route.ts). If unset, falls back to free
# Nominatim geocoding + OSRM routing (src/lib/routing.ts).
GOOGLE_MAPS_API_KEY=""

# Routing/geocoding endpoints used by the free fallback path. The public demo
# servers rate-limit aggressively and have no SLA — point these at self-hosted
# instances (see docker-compose.yml's `osrm` service) for any real traffic.
OSRM_URL="http://router.project-osrm.org"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
# Nominatim's usage policy requires a User-Agent identifying the application.
GEOCODER_USER_AGENT="IncidentAlerts/1.0 (traffic incident alert service)"
# Address autocomplete backend (Photon). Defaults to the public instance.
# PHOTON_URL="https://photon.komoot.io"

# Upstash Redis, used to back API rate limiting (src/lib/rate-limit.ts).
# Strongly recommended in production: without it the limiter falls back to
# per-instance in-memory counters, which serverless concurrency trivially
# bypasses. Both values come from the Upstash console's REST section.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
